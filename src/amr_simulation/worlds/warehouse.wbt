# Warehouse AMR
Robot {
  translation 0 0 0.12
  name "WarehouseAMR"
  controller "<extern>"

  children [
    # Chassis
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.3 0.8
        roughness 0.6
        metalness 0.1
      }
      geometry Box {
        size 0.50 0.36 0.20
      }
    }

    # Left wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 0.20 -0.045
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "left_wheel_joint"
          maxTorque 20
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.20 -0.045
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 1
            }
            geometry Cylinder {
              radius 0.075
              height 0.04
            }
          }
        ]
        name "left_wheel"
        boundingObject Cylinder {
          radius 0.075
          height 0.04
        }
        physics Physics {
          mass 0.8
        }
      }
    }

    # Right wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 -0.20 -0.045
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "right_wheel_joint"
          maxTorque 20
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.20 -0.045
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 1
            }
            geometry Cylinder {
              radius 0.075
              height 0.04
            }
          }
        ]
        name "right_wheel"
        boundingObject Cylinder {
          radius 0.075
          height 0.04
        }
        physics Physics {
          mass 0.8
        }
      }
    }

    # Passive ball casters (front and rear) keep the chassis level on the two drive wheels.
    # Visual spheres here; their collision spheres are part of the Robot boundingObject below,
    # with frictionless contact (contactMaterial "caster").
    Pose {
      translation 0.20 0 -0.09
      children [ Shape { appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 0.5 } geometry Sphere { radius 0.03 } } ]
    }
    Pose {
      translation -0.20 0 -0.09
      children [ Shape { appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 0.5 } geometry Sphere { radius 0.03 } } ]
    }

    # LiDAR
    Lidar {
      translation 0.15 0 0.15
      name "amr_lidar"
      horizontalResolution 360
      fieldOfView 6.28318
      numberOfLayers 1
      near 0.05
      minRange 0.05
      maxRange 8
      noise 0
    }

    # Camera placeholder: we will enable ROS camera publishing
    # after the first drive and LiDAR tests.
  ]

  contactMaterial "caster"
  boundingObject Group {
    children [
      Box {
        size 0.50 0.36 0.20
      }
      Pose {
        translation 0.20 0 -0.09
        children [ Sphere { radius 0.03 } ]
      }
      Pose {
        translation -0.20 0 -0.09
        children [ Sphere { radius 0.03 } ]
      }
    ]
  }

  physics Physics {
    mass 15
  }
}
