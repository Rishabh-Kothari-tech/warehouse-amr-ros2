    Pose { translation 0.90 0 -0.35 children [ Shape { appearance PBRAppearance { baseColor 0.72 0.55 0.35 roughness 0.9 } geometry Box { size 0.5 0.55 0.35 } } ] }
    Pose { translation 0.90 0 0.20 children [ Shape { appearance PBRAppearance { baseColor 0.72 0.55 0.35 roughness 0.9 } geometry Box { size 0.5 0.55 0.35 } } ] }
    Pose { translation 0.90 0 0.75 children [ Shape { appearance PBRAppearance { baseColor 0.72 0.55 0.35 roughness 0.9 } geometry Box { size 0.5 0.55 0.35 } } ] }
  ]
  name "rack_C2"
  boundingObject Box { size 2.80 0.80 1.80 }
}

