<?xml version="1.0"?>
<robot name="warehouse_amr">
    <link name="base_footprint"/>
    <!-- Main robot chassis -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <box size="0.50 0.36 0.20"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.8 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <box size="0.50 0.36 0.20"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.12"/>
            <mass value="15.0"/>
            <inertia ixx="0.20" ixy="0" ixz="0"
                     iyy="0.40" iyz="0"
                     izz="0.50"/>
        </inertial>
    </link>

    <!-- Left wheel -->
    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin rpy="1.5708 0 0"/>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin rpy="1.5708 0 0"/>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <inertia ixx="0.002" ixy="0" ixz="0"
                     iyy="0.002" iyz="0"
                     izz="0.002"/>
        </inertial>
    </link>

    <!-- Right wheel -->
    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin rpy="1.5708 0 0"/>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <inertia ixx="0.002" ixy="0" ixz="0"
                     iyy="0.002" iyz="0"
                     izz="0.002"/>
        </inertial>
    </link>

    <!-- Left wheel joint -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.20 0.075" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Right wheel joint -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.20 0.075" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- LiDAR -->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.045" length="0.05"/>
            </geometry>
            <material name="red">
                <color rgba="0.9 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_link"/>
        <origin xyz="0.15 0 0.27"/>
    </joint>

    <!-- Camera -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.06 0.08 0.04"/>
            </geometry>
            <material name="green">
                <color rgba="0.1 0.8 0.2 1"/>
            </material>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.22 0 0.22"/>
    </joint>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
</robot>
